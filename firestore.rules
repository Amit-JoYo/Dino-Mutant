rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin accounts are added by hand in the Firebase console: admins/{uid}.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function classIsActive(code) {
      return get(/databases/$(database)/documents/classes/$(code)).data.active == true;
    }

    function isMember(code) {
      return signedIn() && exists(/databases/$(database)/documents/classes/$(code)/members/$(request.auth.uid));
    }

    function validMember() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'locked', 'dinos', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 12
        && d.locked is bool
        && d.dinos is list && d.dinos.size() <= 3;
    }

    function validReaction() {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'at'])
        && d.kind in ['wave', 'heart', 'party', 'star']
        && d.at == request.time;
    }

    // Gifts are regular dinos only (no legendaries, no starter T-Rex).
    function validGift() {
      let d = request.resource.data;
      return d.keys().hasOnly(['species', 'tint', 'at'])
        && d.species in ['brachio', 'trike', 'ptero', 'stego', 'anky', 'raptor', 'para', 'spino', 'plesio']
        && d.tint is int && d.tint >= 0 && d.tint < 20
        && d.at == request.time;
    }

    match /admins/{id} {
      allow read: if signedIn() && request.auth.uid == id;
      allow write: if false;
    }

    match /classes/{code} {
      // Reading one class needs its code; classes cannot be listed except by admins.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();

      match /members/{uid} {
        // Emoji reactions: one document per sender, so a sender can only overwrite (not flood), at most every 5 seconds.
        // The sender's name is never stored here; the receiver looks it up from the member list.
        match /reactions/{from} {
          allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
          allow create: if signedIn() && request.auth.uid == from && from != uid
            && isMember(code) && classIsActive(code)
            && exists(/databases/$(database)/documents/classes/$(code)/members/$(uid))
            && validReaction();
          allow update: if signedIn() && request.auth.uid == from
            && isMember(code) && classIsActive(code)
            && validReaction()
            && request.time > resource.data.at + duration.value(5, 's');
          allow delete: if (signedIn() && (request.auth.uid == uid || request.auth.uid == from)) || isAdmin();
        }

        // Gifts: one pending gift per sender (the document id is the sender), removed by the receiver when accepted.
        match /gifts/{from} {
          allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
          allow create: if signedIn() && request.auth.uid == from && from != uid
            && isMember(code) && classIsActive(code)
            && exists(/databases/$(database)/documents/classes/$(code)/members/$(uid))
            && validGift();
          allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
        }

        allow read: if (signedIn() && request.auth.uid == uid)
          || (isMember(code) && classIsActive(code))
          || isAdmin();

        allow create: if signedIn() && request.auth.uid == uid
          && validMember()
          && request.resource.data.locked == false
          && classIsActive(code);

        // Members cannot change the lock, and cannot rename themselves while locked.
        allow update: if (signedIn() && request.auth.uid == uid
            && validMember()
            && request.resource.data.locked == resource.data.locked
            && (!resource.data.locked || request.resource.data.name == resource.data.name))
          || isAdmin();

        allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
      }
    }
  }
}
